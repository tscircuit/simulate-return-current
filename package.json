{
  "name": "simulate-return-current",
  "version": "0.0.1",
  "description": "Simulate PCB return current from tscircuit circuit-json with Palace EM or a TypeScript approximation",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./palace": {
      "types": "./dist/palace.d.ts",
      "import": "./dist/palace.js"
    },
    "./circuit-json": {
      "types": "./dist/circuit-json-simulation.d.ts",
      "import": "./dist/circuit-json.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/simulate-return-current.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "build:site": "cosmos-export",
    "generate:examples": "bun scripts/generate-examples.tsx",
    "render": "bun scripts/render-circuit.ts",
    "palace": "bun scripts/run-palace.ts",
    "generate:palace": "bun scripts/generate-palace-examples.tsx",
    "resample:palace": "bun scripts/resample-palace.ts",
    "generate:palace:wide-gap": "bun scripts/generate-wide-gap-example.tsx",
    "build": "bun run typecheck && bun scripts/build-package.ts",
    "prepack": "bun run build",
    "smoke:package": "bun scripts/smoke-package.tsx"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/solver-utils": "0.0.21",
    "circuit-json": "0.0.522",
    "graphics-debug": "0.0.76",
    "transformation-matrix": "2.16.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tscircuit/copper-pour-solver": "^0.0.67",
    "@tscircuit/core": "0.0.2079",
    "@tscircuit/image-utils": "^0.0.8",
    "@tscircuit/infer-cable-insertion-point": "^0.0.4",
    "@tscircuit/miniflex": "^0.0.4",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.15",
    "bun-match-svg": "0.0.17",
    "calculate-elbow": "^0.0.12",
    "debug": "^4.3.6",
    "earcut": "3.0.1",
    "flatbush": "^4.5.0",
    "minicssgrid": "^0.0.9",
    "react": "19.2.6",
    "react-cosmos": "7.4.1",
    "react-cosmos-plugin-vite": "7.4.0",
    "react-dom": "19.2.6",
    "spicey": "^0.0.14",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simulate-return-current": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "homepage": "https://github.com/tscircuit/simulate-return-current#readme",
  "bugs": {
    "url": "https://github.com/tscircuit/simulate-return-current/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
